MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/registrations?retryWrites=true&w=majority&appName=Cluster0
PORT=4000

# Optional. If these are present, photos upload to Cloudinary.
# Without them, photos are stored in MongoDB as data URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=registration-photos
CORS_ORIGIN=https://your-frontend-domain.vercel.app,http://localhost:3000,http://localhost:5173
