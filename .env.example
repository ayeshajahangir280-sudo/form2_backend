PORT=4000
NODE_ENV=development

MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/registrations?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=registrations_db

FRONTEND_URL=https://themaskedcup.stride-events.net
CORS_ORIGIN=https://themaskedcup.stride-events.net,http://localhost:3000,http://localhost:5173

# Stripe Checkout (AED 159 registration payment)
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional. If these are present, photos upload to Cloudinary.
# Without them, photos are stored in MongoDB as data URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=registration-photos
